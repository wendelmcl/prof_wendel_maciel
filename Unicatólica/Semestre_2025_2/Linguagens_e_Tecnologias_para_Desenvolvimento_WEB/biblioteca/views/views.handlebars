<div id="livro-view-container" class="container">
    <div class="row text-center">
        <a class="back-link main-color" href="/">Voltar</a>
        <div id="img-container" class="col-md-12">
            <img src="/img/background.jpg" alt="Imagem de livros empilhados">
        </div>
        <div class="col-md-12">
            <h1 class="main-color">{{livro.dataValues.titulo}}</h1>
            <p class="bold">Autor:</p>
            <p class="bold">{{livro.dataValues.autor}}</p>
            <p class="bold">Ano de publicação</p>
            <p class="bold">{{livro.dataValues.anoPublicacao}}</p>
        </div>
    </div>
</div>