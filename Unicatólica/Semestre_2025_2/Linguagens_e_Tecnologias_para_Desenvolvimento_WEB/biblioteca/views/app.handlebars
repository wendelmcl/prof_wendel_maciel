<div id="top-container" class="container-fluid">
    <h1 id="main-title" class="text-center">Encontre seu livro favorito</h1>
    <p id="main-subtitle" class="text-center">Somos o site com o maior número de livros do Brasil</p>
    <form id="search-form" class="form-inline row" action="/" method="GET">
        <div class="form-group col-md-10">
            <input type="text" class="form-control" id="livro" name="livro" placeholder="Digite o nome do livro">
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Procurar</button>
        </div>
    </form>
</div>
<main>
    <div id="livros-container" class="container">
        <div class="row">
            <div class="col-md-12">
                {{#if search}}
                <h2 id="livro-list-title"> Buscando os livros que contém: {{search}}</h2>
                {{else}}
                <h2 id="livro-list-title"> Veja nossos livros em destaque</h2>
                {{/if}}
                <ul id="livro-list" class="list-group">
                    {{#each livros}}
                    <li class="list-group-item {{#if dataValues.new_livro}} new-livro{{/if}}">
                        <img src="/img/livro.jpg" alt="Livros em formato de ilustração">
                        <p>{{dataValues.autor}}</p>
                        <h2>{{dataValues.titulo}}</h2>
                        <p>{{dataValues.anoPublicacao}}</p>
                        <span class="new-livro-label">Nova</span>
                        <a class="btn btn-primary" href="/livros/view/{{dataValues.id}}">Ver Livro</a>
                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>
</main>


